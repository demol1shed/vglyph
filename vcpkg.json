{
  "name": "vglyph",
  "version-string": "0.0.0",
  "license": "GPL-3.0-only",
  "features": {
    "media": {
      "description": "FFmpeg decoding and encoding (enabled from phase 2)",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": ["avcodec", "avformat", "swscale", "gpl", "x264"]
        }
      ]
    },
    "gui": {
      "description": "Desktop GUI (vglyph-gui)",
      "dependencies": [
        "sdl3",
        {
          "name": "imgui",
          "features": ["sdl3-binding", "sdl3-renderer-binding"]
        }
      ]
    }
  }
}
