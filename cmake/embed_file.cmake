# Turns a binary file into a C++ header holding a read-only byte array.
#
# Usage: cmake -DINPUT=<file> -DOUTPUT=<header> -P embed_file.cmake
#
# The header defines vglyph::embedded::kFontData and kFontSize. The output is
# pure ASCII (hex literals only), so MSVC reads it in any code page.

if(NOT INPUT OR NOT OUTPUT)
  message(FATAL_ERROR "embed_file.cmake needs -DINPUT=<file> -DOUTPUT=<header>")
endif()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
if(hex_length EQUAL 0)
  message(FATAL_ERROR "embed_file.cmake: ${INPUT} is empty or unreadable")
endif()

# "0a1b..." -> "0x0a,0x1b,..." then a line break after every 16 bytes
# (CMake regular expressions have no {n} repetition, so the pattern is built).
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_unit)
string(REGEX REPLACE "(${line_unit})" "\\1\n" bytes "${bytes}")

file(WRITE "${OUTPUT}"
"// Generated by cmake/embed_file.cmake from the default font. Do not edit.
#pragma once

#include <cstddef>

namespace vglyph::embedded {

inline constexpr unsigned char kFontData[] = {
${bytes}
};
inline constexpr std::size_t kFontSize = sizeof(kFontData);

}  // namespace vglyph::embedded
")
